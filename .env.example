AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

AWS_REGION=us-east-1

# ============================================================================ Despliegue
# Nombre del entorno: se usa en todos los recursos (fashrec-<stage>, bucket fashrec-data-<cuenta>-<región>-<stage>).
FASHREC_STAGE=dev

FASHREC_SLS=osls

# Red del dashboard y de las tareas Fargate. Vacío = se detecta la VPC por defecto y una subred pública
FASHREC_VPC_ID=
FASHREC_SUBNET_ID=
FASHREC_ALLOWED_CIDR=0.0.0.0/0

# ============================================================================ Qué hacer (equivalen a las opciones --seed, etc.)
# 1 = sí, 0 = no.
# Sube a S3 el modelo ya entrenado en local, carga DynamoDB y prueba la API (evidencia sin esperar al pipeline).
FASHREC_SEED=1
# Sube los 2 JSONL originales (2.5 GB) a S3; necesario para ejecutar el pipeline completo con Glue.
FASHREC_UPLOAD_RAW=0
# Ejecuta el pipeline en AWS (ETL en Glue + 6 tareas Fargate + carga de DynamoDB) y espera el resultado.
FASHREC_RUN_PIPELINE=0
FASHREC_WAIT_PIPELINE=0
# Enciende el dashboard al final e imprime su URL (cobra ≈ $0.05/hora mientras esté encendido).
FASHREC_START_DASHBOARD=1
# No reconstruir las imágenes Docker (ya están en ECR).
FASHREC_SKIP_IMAGES=0